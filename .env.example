# Copy to .env and edit. scripts/setup.sh does this for you interactively.

# --- Identity -----------------------------------------------------------
# UID/GID that owns the media files (run `id` to find yours)
PUID=1000
PGID=1000
# GID of the host 'render' group (run: getent group render | cut -d: -f3)
RENDER_GID=109
TZ=America/New_York

# --- Media storage --------------------------------------------------------
# ENCRYPTION=vault : media lives in a gocryptfs vault. VAULT_DIR holds the
#                    ENCRYPTED bytes (safe to back up raw); MEDIA_MOUNT is the
#                    DECRYPTED view, mounted only while the stack runs.
# ENCRYPTION=plain : no at-rest encryption. MEDIA_MOUNT is just a normal
#                    directory holding the library; VAULT_DIR is ignored.
# Everything else (TLS, GPU transcoding, apps, scripts) is identical in both.
ENCRYPTION=vault
VAULT_DIR=/srv/plextra/vault
MEDIA_MOUNT=/srv/plextra/media-plain
# Optional: keep app databases/metadata somewhere other than
# MEDIA_MOUNT/appdata — e.g. Unraid SSD cache: /mnt/user/appdata/plextra.
# Leave EMPTY in vault mode so appdata stays inside the encrypted vault.
APPDATA_MOUNT=

# --- Hostnames & TLS ----------------------------------------------------
# Mesh mode (recommended): give the three app hosts names under a domain you
#   own (they resolve to the server both on the LAN and over the built-in
#   VPN); only MESH_HOST needs public DNS pointing at your IP.
# LAN mode: keep .local names, Caddy issues its own internal CA.
JELLYFIN_HOST=media.local
BOOKS_HOST=books.local
REQUESTS_HOST=requests.local
ACME_EMAIL=

# Built-in mesh VPN (headscale). MESH_HOST must be a real, publicly
# resolvable domain with ports 443/tcp, 3478/udp, 41641/udp reachable —
# it's how devices join and relay into this server's private mesh.
MESH_HOST=mesh.example.com
# Written automatically by scripts/mesh-init.sh — leave blank.
TS_AUTHKEY=

# Which Caddy config to use:
#   ./caddy/Caddyfile.mesh    -> only the mesh endpoint public; apps private (recommended)
#   ./caddy/Caddyfile.lan     -> LAN only, no mesh join endpoint, internal CA
#   ./caddy/Caddyfile.public  -> everything on public Let's Encrypt HTTPS
CADDYFILE=./caddy/Caddyfile.mesh

# --- Requests (Jellyseerr + quota-warden) --------------------------------
# API key from Jellyseerr -> Settings -> General (after first-run setup).
JELLYSEERR_API_KEY=
# Your existing Radarr/Sonarr instances (URLs reachable from this host's
# docker network, e.g. http://host.docker.internal:7878 or http://radarr:7878
# if they share the 'plextra' network). Leave blank to skip size lookups.
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=

# Copy to .env and edit. scripts/setup.sh does this for you interactively.

# --- Identity -----------------------------------------------------------
# UID/GID that owns the media files (run `id` to find yours)
PUID=1000
PGID=1000
# GID of the host 'render' group (run: getent group render | cut -d: -f3)
RENDER_GID=109
TZ=America/New_York

# --- Media storage --------------------------------------------------------
# ENCRYPTION=vault : media lives in a gocryptfs vault. VAULT_DIR holds the
#                    ENCRYPTED bytes (safe to back up raw); MEDIA_MOUNT is the
#                    DECRYPTED view, mounted only while the stack runs.
# ENCRYPTION=plain : no at-rest encryption. MEDIA_MOUNT is just a normal
#                    directory holding the library; VAULT_DIR is ignored.
# Everything else (TLS, GPU transcoding, apps, scripts) is identical in both.
ENCRYPTION=vault
VAULT_DIR=/srv/plextra/vault
MEDIA_MOUNT=/srv/plextra/media-plain

# --- Hostnames & TLS ----------------------------------------------------
# LAN/VPN mode (default): keep .local names, Caddy issues its own internal CA.
#   Trust the CA once per device: docs/SECURITY.md explains how.
# Public mode: set real DNS names + ACME_EMAIL, and switch CADDYFILE below.
JELLYFIN_HOST=media.local
BOOKS_HOST=books.local
ACME_EMAIL=

# Which Caddy config to use:
#   ./caddy/Caddyfile.lan     -> internal CA, never touches the internet (default)
#   ./caddy/Caddyfile.public  -> automatic Let's Encrypt for real domains
CADDYFILE=./caddy/Caddyfile.lan

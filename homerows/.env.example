# Jellyfin server URL as reachable from this container
JELLYFIN_URL=http://192.168.1.50:8096
# Admin API key: Dashboard -> Advanced -> API Keys -> +
JELLYFIN_API_KEY=
# Re-sync cadence (seconds); 21600 = 6h
INTERVAL_SECONDS=21600
# Optional prefix to group rows together in Collections views, e.g. "· "
ROW_PREFIX=
